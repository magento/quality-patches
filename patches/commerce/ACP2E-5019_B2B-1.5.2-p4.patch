+namespace Magento\SharedCatalog\Model\Form\Storage\Session;
+
+use Magento\Framework\Exception\LocalizedException;
+use Magento\Framework\Session\Generic;
+
+/**
+ * Session read/write layer for wizard storage.
+ *
+ * @SuppressWarnings(PHPMD.CookieAndSessionMisuse)
+ */
+class WizardStorageSession
+{
+    private const STORE_ID_KEY = 'store_id';
+
+    /**
+     * @param Generic $session
+     * @param string $key
+     */
+    public function __construct(
+        private readonly Generic $session,
+        private readonly string $key
+    ) {
+    }
+
+    /**
+     * Read array data for the given key from the session.
+     *
+     * @param string $paramKey
+     * @return array
+     * @throws LocalizedException When the session backend fails to return data.
+     */
+    public function read(string $paramKey): array
+    {
+        $data = $this->session->getData($this->buildKey($paramKey));
+        if ($data === null) {
+            throw new LocalizedException(
+                __('Session data could not be loaded. Please refresh the page and try again.')
+            );
+        }
+        return $data;
+    }
+
+    /**
+     * Write array data for the given key to the session.
+     *
+     * @param string $paramKey
+     * @param array $value
+     * @return void
+     */
+    public function write(string $paramKey, array $value): void
+    {
+        $this->session->setData($this->buildKey($paramKey), $value);
+    }
+
+    /**
+     * Get selected shared catalog store ID from session.
+     *
+     * @return int
+     */
+    public function getStoreId(): int
+    {
+        return (int)$this->session->getData(self::STORE_ID_KEY);
+    }
+
+    /**
+     * Set selected shared catalog store ID to session.
+     *
+     * @param int $id
+     * @return void
+     */
+    public function setStoreId(int $id): void
+    {
+        $this->session->setData(self::STORE_ID_KEY, $id);
+    }
+
+    /**
+     * Build prefixed session key.
+     *
+     * @param string $paramKey
+     * @return string
+     */
+    private function buildKey(string $paramKey): string
+    {
+        return sprintf('%s_%s', $this->key, $paramKey);
+    }
+}
