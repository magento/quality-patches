+namespace Magento\NegotiableQuote\Model\NegotiableItem;
+
+use Magento\NegotiableQuote\Api\Data\NegotiableQuoteItemInterface;
+use Magento\NegotiableQuote\Model\QuoteItemHashHandler;
+use Magento\NegotiableQuote\Model\ResourceModel\NegotiableQuoteItem as NegotiableQuoteItemResource;
+use Magento\Quote\Api\Data\CartInterface;
+
+/**
+ * Applies and persists negotiated price data for quote items during quote updates.
+ *
+ * Handles both in-place items (via hash matching from AddNegotiatedPriceInfo) and
+ * reconfigured items that were removed and re-added in memory without a DB save.
+ */
+class NegotiatedPriceApplier
+{
+    /**
+     * @param AddNegotiatedPriceInfo $addNegotiatedPriceInfo
+     * @param QuoteItemHashHandler $quoteItemHashHandler
+     * @param NegotiableQuoteItemResource $negotiableQuoteItemResource
+     */
+    public function __construct(
+        private readonly AddNegotiatedPriceInfo $addNegotiatedPriceInfo,
+        private readonly QuoteItemHashHandler $quoteItemHashHandler,
+        private readonly NegotiableQuoteItemResource $negotiableQuoteItemResource
+    ) {
+    }
+
+    /**
+     * Apply negotiated price data to quote items.
+     *
+     * For reconfigured items (re-added in memory without a DB id), discount data preserved
+     * in $deferredNegotiableData is matched to the new items by product hash before the
+     * standard AddNegotiatedPriceInfo hash-matching runs.
+     *
+     * @param CartInterface $quote
+     * @param array $itemsData items data from the request (may include item_hash entries)
+     * @param array $deferredNegotiableData discount data keyed by productSku
+     * @param array $remainingItems items updated in-place, keyed by item_id
+     */
+    public function apply(
+        CartInterface $quote,
+        array $itemsData,
+        array $deferredNegotiableData = [],
+        array $remainingItems = []
+    ): void {
+        if (!empty($deferredNegotiableData)) {
+            $itemsData = $this->appendReconfiguredItemData(
+                $quote,
+                $itemsData,
+                $deferredNegotiableData,
+                $remainingItems
+            );
+        }
+        $this->addNegotiatedPriceInfo->execute($quote, $itemsData);
+    }
+
+    /**
+     * Persist negotiated price extension attribute data to the negotiable_quote_item table.
+     *
+     * Required when addConfiguredItems internally saves the quote, clearing the CartRepository
+     * identity map. Without this, subsequent reloads in updateQuoteItemsCustomPrices would
+     * lose the in-memory discount data set by AddNegotiatedPriceInfo.
+     *
+     * @param CartInterface $quote
+     */
+    public function persist(CartInterface $quote): void
+    {
+        $itemsToSave = [];
+        foreach ($quote->getAllItems() as $quoteItem) {
+            $negotiableItem = $quoteItem->getExtensionAttributes()?->getNegotiableQuoteItem();
+            if (!$negotiableItem || !$negotiableItem->getItemId()) {
+                continue;
+            }
+            $ext = $negotiableItem->getExtensionAttributes();
+            if (!$ext) {
+                continue;
+            }
+            $negotiableItem->setData(
+                NegotiableQuoteItemInterface::NEGOTIATED_PRICE_TYPE,
+                $ext->getNegotiatedPriceType()
+            );
+            $negotiableItem->setData(
+                NegotiableQuoteItemInterface::NEGOTIATED_PRICE_VALUE,
+                $ext->getNegotiatedPriceValue()
+            );
+            $negotiableItem->setData(
+                NegotiableQuoteItemInterface::IS_DISCOUNTING_LOCKED,
+                (int)$ext->getIsDiscountingLocked()
+            );
+            $itemsToSave[] = $negotiableItem;
+        }
+        if ($itemsToSave) {
+            $this->negotiableQuoteItemResource->saveList($itemsToSave);
+        }
+    }
+
+    /**
+     * Append hash-matched negotiable price entries for items that were reconfigured.
+     *
+     * @param CartInterface $quote
+     * @param array $itemsData
+     * @param array $deferredNegotiableData keyed by productSku
+     * @param array $remainingItems keyed by item_id
+     * @return array
+     */
+    private function appendReconfiguredItemData(
+        CartInterface $quote,
+        array $itemsData,
+        array $deferredNegotiableData,
+        array $remainingItems
+    ): array {
+        foreach ($quote->getAllVisibleItems() as $quoteItem) {
+            if (array_key_exists((int)$quoteItem->getItemId(), $remainingItems)) {
+                continue;
+            }
+            $productSku = $quoteItem->getProduct()->getSku();
+            if (!isset($deferredNegotiableData[$productSku])) {
+                continue;
+            }
+            $entry = $deferredNegotiableData[$productSku];
+            $entry['item_hash'] = $this->quoteItemHashHandler->getItemHashToIdItem($quoteItem);
+            $itemsData[] = $entry;
+            unset($deferredNegotiableData[$productSku]);
+        }
+        return $itemsData;
+    }
+}
