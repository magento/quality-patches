+declare(strict_types=1);
+
+namespace Magento\NegotiableQuote\Plugin\Quote\Model;
+
+use Magento\Quote\Model\Quote;
+use Magento\Quote\Model\Quote\AddressFactory;
+use Magento\Quote\Model\ResourceModel\Quote\Address\Collection;
+
+/**
+ * Override addresses collection getter to avoid caching
+ */
+class QuoteAddressesCollectionPlugin
+{
+    /**
+     * @param AddressFactory $addressFactory
+     */
+    public function __construct(
+        private readonly AddressFactory $addressFactory
+    ) {
+    }
+
+    /**
+     * Repopulate addresses collection
+     *
+     * @param Quote $subject
+     * @param Collection|null $result
+     * @return Collection|null
+     */
+    public function afterGetAddressesCollection(
+        Quote $subject,
+        ?Collection $result
+    ) {
+        if ($subject->getExtensionAttributes() && $subject->getExtensionAttributes()->getNegotiableQuote()
+            && $subject->getData('avoid_addresses_cache') === true) {
+            $id = $subject->getId();
+            if ((int)$id !== 0 && !empty($result)) {
+                $result = $this->addressFactory->create()->getCollection()->setQuoteFilter($id);
+            }
+        }
+        foreach ($result as $address) {
+            $address->setQuote($subject);
+        }
+        return $result;
+    }
+}
