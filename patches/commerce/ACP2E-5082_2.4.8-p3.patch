+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\PricePermissions\Model\ResourceModel;
+
+use Magento\Framework\App\ResourceConnection;
+
+class PriceAttributePermissions
+{
+    /**
+     * @var ResourceConnection
+     */
+    private ResourceConnection $resource;
+
+    /**
+     * @param ResourceConnection $resource
+     */
+    public function __construct(ResourceConnection $resource)
+    {
+        $this->resource = $resource;
+    }
+
+    /**
+     * Returns attribute IDs that have an existing store-view EAV record.
+     *
+     * @param array $byTable Map of [tableName => [attributeId => attributeCode]]
+     * @param string $linkField
+     * @param int $linkFieldValue
+     * @param int $storeId
+     * @return int[]
+     */
+    public function getExistingStoreViewAttributeIds(
+        array $byTable,
+        string $linkField,
+        int $linkFieldValue,
+        int $storeId
+    ): array {
+        $connection = $this->resource->getConnection();
+        $existing = [];
+        foreach ($byTable as $table => $attrIdToCode) {
+            $rows = array_map(
+                'intval',
+                $connection->fetchCol(
+                    $connection->select()
+                        ->from($table, 'attribute_id')
+                        ->where($linkField . ' = ?', $linkFieldValue)
+                        ->where('store_id = ?', $storeId)
+                        ->where('attribute_id IN (?)', array_keys($attrIdToCode))
+                )
+            );
+            $existing[] = $rows;
+        }
+        return $existing ? array_merge(...$existing) : [];
+    }
+}
