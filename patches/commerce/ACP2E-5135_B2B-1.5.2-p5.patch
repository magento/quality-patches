+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\BundleSharedCatalog\Model\ResourceModel;
+
+use Magento\Catalog\Api\Data\ProductInterface;
+use Magento\Framework\App\ResourceConnection;
+use Magento\Framework\EntityManager\MetadataPool;
+
+/**
+ * Detects whether a bundle product has a required option with no selection available in a shared catalog.
+ */
+class BundleRequiredOptionAvailability
+{
+    /**
+     * @var ResourceConnection
+     */
+    private $resource;
+
+    /**
+     * @var MetadataPool
+     */
+    private $metadataPool;
+
+    /**
+     * @param ResourceConnection $resource
+     * @param MetadataPool $metadataPool
+     */
+    public function __construct(
+        ResourceConnection $resource,
+        MetadataPool $metadataPool
+    ) {
+        $this->resource = $resource;
+        $this->metadataPool = $metadataPool;
+    }
+
+    /**
+     * Whether a bundle has at least one required option with no selection in the shared catalog.
+     *
+     * @param int $productId Bundle product entity id
+     * @param int $customerGroupId
+     * @return bool
+     * @throws \Exception
+     */
+    public function isUnavailableForGroup(int $productId, int $customerGroupId): bool
+    {
+        $connection = $this->resource->getConnection();
+        $linkField = $this->metadataPool->getMetadata(ProductInterface::class)->getLinkField();
+
+        $notExists = sprintf(
+            'NOT EXISTS (SELECT 1 FROM %s AS s'
+            . ' INNER JOIN %s AS child ON child.entity_id = s.product_id'
+            . ' INNER JOIN %s AS sci ON sci.sku = child.sku AND sci.customer_group_id = %d'
+            . ' WHERE s.option_id = o.option_id)',
+            $connection->quoteIdentifier($this->resource->getTableName('catalog_product_bundle_selection')),
+            $connection->quoteIdentifier($this->resource->getTableName('catalog_product_entity')),
+            $connection->quoteIdentifier($this->resource->getTableName('shared_catalog_product_item')),
+            $customerGroupId
+        );
+
+        $select = $connection->select()
+            ->from(
+                ['o' => $this->resource->getTableName('catalog_product_bundle_option')],
+                ['o.option_id']
+            )->joinInner(
+                ['cpe' => $this->resource->getTableName('catalog_product_entity')],
+                sprintf('cpe.%s = o.parent_id', $linkField),
+                []
+            )->where('cpe.entity_id = ?', $productId, 'INT')
+            ->where('o.required = ?', 1, 'INT')
+            ->where($notExists)
+            ->limit(1);
+
+        return (bool) $connection->fetchOne($select);
+    }
+
+    /**
+     * Resolve bundle parent product entity ids that contain any of the given child product ids as selections.
+     *
+     * Used to expand shared-catalog reindex lists so a child membership change also recomputes the
+     * bundle parent's permission grants.
+     *
+     * @param int[] $childProductIds
+     * @return int[]
+     */
+    public function getParentProductIdsByChildProductIds(array $childProductIds): array
+    {
+        $childProductIds = array_filter(array_map('intval', $childProductIds));
+        if (!$childProductIds) {
+            return [];
+        }
+        $connection = $this->resource->getConnection();
+        $linkField = $this->metadataPool->getMetadata(ProductInterface::class)->getLinkField();
+        $select = $connection->select()
+            ->distinct()
+            ->from(
+                ['s' => $this->resource->getTableName('catalog_product_bundle_selection')],
+                []
+            )->joinInner(
+                ['o' => $this->resource->getTableName('catalog_product_bundle_option')],
+                'o.option_id = s.option_id',
+                []
+            )->joinInner(
+                ['parent' => $this->resource->getTableName('catalog_product_entity')],
+                sprintf('parent.%s = o.parent_id', $linkField),
+                ['parent.entity_id']
+            )->where('s.product_id IN (?)', $childProductIds);
+
+        return array_map('intval', $connection->fetchCol($select));
+    }
+
+    /**
+     * Return the SKUs, from the given list, that are NOT in the customer group's shared catalog.
+     *
+     * @param string[] $skus
+     * @param int $customerGroupId
+     * @return string[]
+     */
+    public function getSkusMissingFromSharedCatalog(array $skus, int $customerGroupId): array
+    {
+        $skus = array_values(array_unique(array_filter($skus, 'strlen')));
+        if (!$skus) {
+            return [];
+        }
+        $connection = $this->resource->getConnection();
+        $select = $connection->select()
+            ->from(
+                ['sci' => $this->resource->getTableName('shared_catalog_product_item')],
+                ['sci.sku']
+            )->where('sci.customer_group_id = ?', $customerGroupId, 'INT')
+            ->where('sci.sku IN (?)', $skus);
+        $present = $connection->fetchCol($select);
+        return array_values(array_diff($skus, $present));
+    }
+}
