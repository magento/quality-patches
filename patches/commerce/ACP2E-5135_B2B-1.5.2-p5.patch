+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\BundleSharedCatalog\Plugin\SharedCatalog\Model;
+
+use Magento\BundleSharedCatalog\Model\ResourceModel\BundleRequiredOptionAvailability;
+use Magento\SharedCatalog\Model\SharedCatalogInvalidation;
+
+/**
+ * When a shared-catalog change triggers a targeted product-permissions reindex, also reindex
+ * the bundle parents that use the changed products as selections.
+ */
+class ExpandReindexToBundleParentsPlugin
+{
+    /**
+     * @var BundleRequiredOptionAvailability
+     */
+    private $optionAvailability;
+
+    /**
+     * @param BundleRequiredOptionAvailability $optionAvailability
+     */
+    public function __construct(BundleRequiredOptionAvailability $optionAvailability)
+    {
+        $this->optionAvailability = $optionAvailability;
+    }
+
+    /**
+     * Append bundle parent ids to the reindexed product id list.
+     *
+     * @param SharedCatalogInvalidation $subject
+     * @param array $productIds
+     * @return array
+     * @SuppressWarnings(PHPMD.UnusedFormalParameter)
+     */
+    public function beforeReindexCatalogProductPermissions(
+        SharedCatalogInvalidation $subject,
+        array $productIds
+    ): array {
+        $parentIds = $this->optionAvailability->getParentProductIdsByChildProductIds($productIds);
+        if ($parentIds) {
+            $productIds = array_values(array_unique(array_merge($productIds, $parentIds)));
+        }
+
+        return [$productIds];
+    }
+}
