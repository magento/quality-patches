@@ -0,0 +1,102 @@
+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\BundleSharedCatalog\Plugin\Quote\Model\Quote;
+
+use Magento\Bundle\Model\Product\Type as BundleType;
+use Magento\BundleSharedCatalog\Model\Product\BundleGroupAvailability;
+use Magento\Quote\Model\Quote\Item;
+
+/**
+ * Flag a bundle quote item as having an error when one of its selected selections is no longer
+ * available in the order customer's shared catalog.
+ *
+ * Hooks the canonical item validation (Quote\Item::checkData) so the item keeps an inline error and
+ * the quote is marked invalid (blocking submission), mirroring how out-of-stock items are surfaced.
+ * The selections that were actually chosen on the item are checked (not just whether the option can be
+ * fulfilled), so an item configured with a selection that has since been removed is detected even when
+ * the option still has other available selections.
+ */
+class ItemPlugin
+{
+    /**
+     * @param BundleGroupAvailability $bundleGroupAvailability
+     */
+    public function __construct(
+        private readonly BundleGroupAvailability $bundleGroupAvailability
+    ) {
+    }
+
+    /**
+     * Add an availability error to a bundle item whose selected selection is not in the shared catalog.
+     *
+     * @param Item $subject
+     * @param Item $result
+     * @return Item
+     */
+    public function afterCheckData(Item $subject, Item $result): Item
+    {
+        $product = $subject->getProduct();
+        $quote = $subject->getQuote();
+        if ($product === null || $quote === null || $product->getTypeId() !== BundleType::TYPE_CODE) {
+            return $result;
+        }
+        $store = $quote->getStore();
+        $customerGroupId = (int) $quote->getCustomerGroupId();
+        $websiteId = $store !== null ? (int) $store->getWebsiteId() : 0;
+
+        $isUnavailable = $this->bundleGroupAvailability
+            ->isUnavailableForGroup($product, $customerGroupId, $websiteId);
+        if (!$isUnavailable) {
+            $isUnavailable = $this->bundleGroupAvailability->hasUnavailableSelectionForGroup(
+                $this->getSelectedSelectionSkus($subject),
+                $customerGroupId,
+                $websiteId
+            );
+        }
+        if ($isUnavailable) {
+            $message = __(
+                'This product can\'t be added to your cart because a required option is not available '
+                . 'in your catalog.'
+            );
+            $subject->setHasError(true)->setMessage($message);
+            $quote->setHasError(true)->addMessage($message, 'shared_catalog_bundle_availability');
+        }
+
+        return $result;
+    }
+
+    /**
+     * Collect the SKUs of the selections actually chosen on the bundle item (its child quote items).
+     *
+     * @param Item $item
+     * @return string[]
+     */
+    private function getSelectedSelectionSkus(Item $item): array
+    {
+        $skus = [];
+        foreach ($item->getChildren() as $child) {
+            $childProduct = $child->getProduct();
+            if ($childProduct !== null && $childProduct->getSku()) {
+                $skus[] = (string) $childProduct->getSku();
+            }
+        }
+
+        return $skus;
+    }
+}
