+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\BundleSharedCatalog\Plugin\Checkout\Model;
+
+use Magento\BundleSharedCatalog\Model\Product\BundleGroupAvailability;
+use Magento\Catalog\Api\ProductRepositoryInterface;
+use Magento\Catalog\Model\Product;
+use Magento\Checkout\Model\Cart;
+use Magento\Framework\Exception\LocalizedException;
+use Magento\Framework\Exception\NoSuchEntityException;
+
+/**
+ * Prevent adding a bundle to the cart when a required option is not available in the
+ * customer's shared catalog, and surface a clear error message.
+ */
+class CartPlugin
+{
+    /**
+     * @param BundleGroupAvailability $bundleGroupAvailability
+     * @param ProductRepositoryInterface $productRepository
+     */
+    public function __construct(
+        private readonly BundleGroupAvailability $bundleGroupAvailability,
+        private readonly ProductRepositoryInterface $productRepository
+    ) {
+    }
+
+    /**
+     * Block adding an unavailable bundle to the cart.
+     *
+     * @param Cart $subject
+     * @param mixed $productInfo
+     * @param mixed|null $requestInfo
+     * @return array
+     * @throws LocalizedException
+     * @SuppressWarnings(PHPMD.UnusedFormalParameter)
+     */
+    public function beforeAddProduct(
+        Cart $subject,
+        mixed $productInfo,
+        mixed $requestInfo = null
+    ): array {
+        $product = $this->getProduct($productInfo);
+
+        if ($product !== null && $this->bundleGroupAvailability->isUnavailableForCurrentGroup($product)) {
+            throw new LocalizedException(
+                __(
+                    'This product can\'t be added to your cart because a required option is not available '
+                    . 'in your catalog.'
+                )
+            );
+        }
+
+        return [$productInfo, $requestInfo];
+    }
+
+    /**
+     * Resolve the product object from the add-to-cart argument.
+     *
+     * @param mixed $productInfo
+     * @return Product|null
+     */
+    private function getProduct(mixed $productInfo): ?Product
+    {
+        if ($productInfo instanceof Product) {
+            return $productInfo;
+        }
+        if (is_int($productInfo) || is_string($productInfo)) {
+            try {
+                return $this->productRepository->getById($productInfo);
+            } catch (NoSuchEntityException $e) {
+                return null;
+            }
+        }
+
+        return null;
+    }
+}
