+namespace Magento\B2b\Model;
+
+/**
+ * Default deadlock/lock-wait recovery tuning.
+ */
+class DeadlockRecoveryConfig implements DeadlockRecoveryConfigInterface
+{
+    /**
+     * @param int $maxAttempts
+     * @param int $baseDelay
+     * @param int $maxDelay
+     * @param int $jitter
+     */
+    public function __construct(
+        private readonly int $maxAttempts = 20,
+        private readonly int $baseDelay = 100000,
+        private readonly int $maxDelay = 2000000,
+        private readonly int $jitter = 250000
+    ) {
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function getMaxAttempts(): int
+    {
+        return $this->maxAttempts;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function getBaseDelay(): int
+    {
+        return $this->baseDelay;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function getMaxDelay(): int
+    {
+        return $this->maxDelay;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function getJitter(): int
+    {
+        return $this->jitter;
+    }
+}
