+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\B2b\Model;
+
+use Magento\Framework\DB\Adapter\DeadlockException;
+use Magento\Framework\DB\Adapter\LockWaitException;
+
+/**
+ * Default deadlock-recovery executor using exponential backoff with jitter.
+ *
+ * Backoff parameters come from DeadlockRecoveryConfigInterface. Only DeadlockException and
+ * LockWaitException trigger a retry; every other Throwable propagates immediately.
+ */
+class DeadlockRecoveryExecutor implements DeadlockRecoveryExecutorInterface
+{
+    /**
+     * @param DeadlockRecoveryConfigInterface $config
+     */
+    public function __construct(
+        private readonly DeadlockRecoveryConfigInterface $config
+    ) {
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function execute(callable $callable, array $args = []): mixed
+    {
+        $attempts = $this->config->getMaxAttempts();
+        for ($attempt = 1; $attempt <= $attempts; $attempt++) {
+            try {
+                return $callable(...$args);
+            } catch (DeadlockException|LockWaitException $exception) {
+                if ($attempt === $attempts) {
+                    throw $exception;
+                }
+                usleep($this->getRetryDelay($attempt));
+            }
+        }
+
+        throw new \LogicException('Retry attempts must be greater than zero.');
+    }
+
+    /**
+     * Exponential backoff with jitter, in microseconds.
+     *
+     * @param int $attempt
+     * @return int
+     */
+    private function getRetryDelay(int $attempt): int
+    {
+        $multiplier = 1 << min($attempt - 1, 5);
+        $baseDelay = min(
+            $this->config->getBaseDelay() * $multiplier,
+            $this->config->getMaxDelay()
+        );
+
+        return $baseDelay + random_int(0, $this->config->getJitter());
+    }
+}
