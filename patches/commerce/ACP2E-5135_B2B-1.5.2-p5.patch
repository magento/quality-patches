+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\BundleSharedCatalog\Model\Product;
+
+use Magento\Bundle\Model\Product\Type as BundleType;
+use Magento\BundleSharedCatalog\Model\ResourceModel\BundleRequiredOptionAvailability;
+use Magento\Catalog\Api\Data\ProductInterface;
+use Magento\Company\Model\CompanyContextFactory;
+use Magento\SharedCatalog\Model\Config;
+use Magento\SharedCatalog\Model\CustomerGroupManagement;
+use Magento\Store\Model\ScopeInterface;
+use Magento\Store\Model\StoreManagerInterface;
+
+/**
+ * Check whether a bundle is unavailable because the required option ware removed from the customer's shared catalog.
+ */
+class BundleGroupAvailability
+{
+    /**
+     * @var BundleRequiredOptionAvailability
+     */
+    private $optionAvailability;
+
+    /**
+     * @var Config
+     */
+    private $config;
+
+    /**
+     * @var CustomerGroupManagement
+     */
+    private $customerGroupManagement;
+
+    /**
+     * @var CompanyContextFactory
+     */
+    private $companyContextFactory;
+
+    /**
+     * @var StoreManagerInterface
+     */
+    private $storeManager;
+
+    /**
+     * @var array
+     */
+    private $memo = [];
+
+    /**
+     * @param BundleRequiredOptionAvailability $optionAvailability
+     * @param Config $config
+     * @param CustomerGroupManagement $customerGroupManagement
+     * @param CompanyContextFactory $companyContextFactory
+     * @param StoreManagerInterface $storeManager
+     */
+    public function __construct(
+        BundleRequiredOptionAvailability $optionAvailability,
+        Config $config,
+        CustomerGroupManagement $customerGroupManagement,
+        CompanyContextFactory $companyContextFactory,
+        StoreManagerInterface $storeManager
+    ) {
+        $this->optionAvailability = $optionAvailability;
+        $this->config = $config;
+        $this->customerGroupManagement = $customerGroupManagement;
+        $this->companyContextFactory = $companyContextFactory;
+        $this->storeManager = $storeManager;
+    }
+
+    /**
+     * Whether the bundle is unavailable for the current storefront customer group.
+     *
+     * @param ProductInterface $product
+     * @return bool
+     */
+    public function isUnavailableForCurrentGroup(ProductInterface $product): bool
+    {
+        $customerGroupId = (int) $this->companyContextFactory->create()->getCustomerGroupId();
+        $websiteId = (int) $this->storeManager->getWebsite()->getId();
+        return $this->isUnavailableForGroup($product, $customerGroupId, $websiteId);
+    }
+
+    /**
+     * Whether the bundle is unavailable for an explicit customer group and website.\
+     *
+     * @param ProductInterface $product
+     * @param int $customerGroupId
+     * @param int $websiteId
+     * @return bool
+     */
+    public function isUnavailableForGroup(ProductInterface $product, int $customerGroupId, int $websiteId): bool
+    {
+        if ($product->getTypeId() !== BundleType::TYPE_CODE) {
+            return false;
+        }
+        $productId = (int) $product->getId();
+        $memoKey = $productId . '_' . $customerGroupId . '_' . $websiteId;
+        if (array_key_exists($memoKey, $this->memo)) {
+            return $this->memo[$memoKey];
+        }
+        $result = false;
+        if ($this->config->isActive(ScopeInterface::SCOPE_WEBSITE, $websiteId)
+            && !$this->customerGroupManagement->isPrimaryCatalogAvailable($customerGroupId)
+        ) {
+            $result = $this->optionAvailability->isUnavailableForGroup($productId, $customerGroupId);
+        }
+        $this->memo[$memoKey] = $result;
+        return $result;
+    }
+
+    /**
+     * Whether any of the given selected selection SKUs is no longer in the customer group's shared catalog.
+     *
+     * @param string[] $selectedSkus
+     * @param int $customerGroupId
+     * @param int $websiteId
+     * @return bool
+     */
+    public function hasUnavailableSelectionForGroup(
+        array $selectedSkus,
+        int $customerGroupId,
+        int $websiteId
+    ): bool {
+        if (!$selectedSkus) {
+            return false;
+        }
+        if (!$this->config->isActive(ScopeInterface::SCOPE_WEBSITE, $websiteId)
+            || $this->customerGroupManagement->isPrimaryCatalogAvailable($customerGroupId)
+        ) {
+            return false;
+        }
+        return (bool) $this->optionAvailability->getSkusMissingFromSharedCatalog($selectedSkus, $customerGroupId);
+    }
+}
