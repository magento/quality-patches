+++ b/vendor/magento/module-google-tag-manager/view/frontend/web/js/model/ecommerce/ga4-formatter.js
@@ -0,0 +1,203 @@
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+
+define([
+    'Magento_GoogleTagManager/js/model/ga4-ecommerce'
+], function (ga4Ecommerce) {
+    'use strict';
+
+    /**
+     * Map a normalized product to the GA4 item schema
+     *
+     * @param {Object} product - {id, name, price, quantity}
+     * @return {Object}
+     */
+    function toGa4Item(product) {
+        return {
+            'item_id': product.id,
+            'item_name': product.name,
+            'price': product.price,
+            'quantity': product.quantity
+        };
+    }
+
+    /**
+     * Calculate event value from normalized products.
+     *
+     * @param {Array} products
+     * @return {Number}
+     */
+    function getEventValue(products) {
+        return products.reduce(function (value, product) {
+            return value + Number(product.price) * Number(product.quantity);
+        }, 0);
+    }
+
+    return {
+        /**
+         * Push add_to_cart event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {Array} products - {id, name, price, quantity}
+         */
+        addToCart: function (dataLayer, currencyCode, products) {
+            ga4Ecommerce.pushEvent('add_to_cart', {
+                'currency': currencyCode,
+                'value': getEventValue(products),
+                'items': products.map(toGa4Item)
+            });
+        },
+
+        /**
+         * Push remove_from_cart event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {Array} products - {id, name, price, quantity}
+         */
+        removeFromCart: function (dataLayer, currencyCode, products) {
+            ga4Ecommerce.pushEvent('remove_from_cart', {
+                'currency': currencyCode,
+                'value': getEventValue(products),
+                'items': products.map(toGa4Item)
+            });
+        },
+
+        /**
+         * Push select_item event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {Object} list
+         * @param {Object} product - {id, name, category, position}
+         */
+        selectItem: function (dataLayer, list, product) {
+            ga4Ecommerce.pushEvent('select_item', {
+                'item_list_name': list,
+                'items': [{
+                    'item_id': product.id,
+                    'item_name': product.name,
+                    'item_category': product.category,
+                    'index': product.position
+                }]
+            });
+        },
+
+        /**
+         * Push view_item_list event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {Array} items - {id, name, category, list, position}
+         */
+        viewItemList: function (dataLayer, items) {
+            ga4Ecommerce.pushEvent('view_item_list', {
+                'items': items.map(function (item) {
+                    return {
+                        'item_id': item.id,
+                        'item_name': item.name,
+                        'item_category': item.category,
+                        'item_list_name': item.list,
+                        'index': item.position
+                    };
+                })
+            });
+        },
+
+        /**
+         * Push view_item event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {Object} product - {id, name, category, price}
+         */
+        viewItem: function (dataLayer, currencyCode, product) {
+            var price = Number(product.price) || 0;
+
+            ga4Ecommerce.pushEvent('view_item', {
+                'currency': currencyCode,
+                'value': price,
+                'items': [{
+                    'item_id': product.id,
+                    'item_name': product.name,
+                    'item_category': product.category,
+                    'price': price
+                }]
+            });
+        },
+
+        /**
+         * Push view_cart event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {Array} products - {id, name, price, quantity}
+         */
+        viewCart: function (dataLayer, currencyCode, products) {
+            ga4Ecommerce.pushEvent('view_cart', {
+                'currency': currencyCode,
+                'value': getEventValue(products),
+                'items': products.map(toGa4Item)
+            });
+        },
+
+        /**
+         * Push begin_checkout or add_shipping_info event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {String} stepIndex
+         * @param {String} stepDescription
+         * @param {Array} products - {id, name, price, quantity}
+         * @param {String} shippingTier
+         */
+        checkoutStep: function (dataLayer, currencyCode, stepIndex, stepDescription, products, shippingTier) {
+            var eventName = stepIndex === '1' ? 'begin_checkout' : 'add_shipping_info',
+                ecommerce = {
+                    'currency': currencyCode,
+                    'value': getEventValue(products),
+                    'items': products.map(toGa4Item)
+                };
+
+            if (eventName === 'add_shipping_info' && shippingTier) {
+                ecommerce.shipping_tier = shippingTier;
+            }
+
+            ga4Ecommerce.pushEvent(eventName, ecommerce);
+        },
+
+        /**
+         * Push add_payment_info event in GA4 format
+         *
+         * @param {Array} dataLayer
+         * @param {String} currencyCode
+         * @param {String} paymentType
+         * @param {Array} products - {id, name, price, quantity}
+         */
+        addPaymentInfo: function (dataLayer, currencyCode, paymentType, products) {
+            var ecommerce = {
+                'currency': currencyCode,
+                'value': getEventValue(products),
+                'items': products.map(toGa4Item)
+            };
+
+            if (paymentType) {
+                ecommerce.payment_type = paymentType;
+            }
+
+            ga4Ecommerce.pushEvent('add_payment_info', ecommerce);
+        }
+    };
+});
