+
+define([], function () {
+    'use strict';
+
+    return {
+        /**
+         * Push a GA4 ecommerce event.
+         *
+         * When window.gtag is available (the analytics4 account type, which loads gtag.js
+         * directly), calls it, matching the direct gtag.js integration pattern.
+         *
+         * @param {String} eventName
+         * @param {Object} ecommerce
+         */
+        pushEvent: function (eventName, ecommerce) {
+            window.dataLayer = window.dataLayer || [];
+
+            if (typeof window.gtag === 'function') {
+                window.gtag('event', eventName, ecommerce);
+            } else {
+                window.dataLayer.push({'ecommerce': null});
+                window.dataLayer.push({
+                    'event': eventName,
+                    'ecommerce': ecommerce
+                });
+            }
+        }
