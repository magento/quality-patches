+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+
+define([
+    'Magento_GoogleTagManager/js/model/ecommerce/ua-formatter',
+    'Magento_GoogleTagManager/js/model/ecommerce/ga4-formatter'
+], function (uaFormatter, ga4Formatter) {
+    'use strict';
+
+    var methods = [
+            'addToCart',
+            'removeFromCart',
+            'selectItem',
+            'viewItemList',
+            'viewItem',
+            'viewCart',
+            'checkoutStep',
+            'addPaymentInfo'
+        ],
+        proxy = {};
+
+    /**
+     * Resolve the formatter at call time rather than at module load time, since the
+     * window.dlAccountType global may not be set yet if this module's dependency graph
+     * resolves before Magento_GoogleTagManager/js/set-account-context runs.
+     */
+    methods.forEach(function (method) {
+        proxy[method] = function () {
+            var formatter = window.dlAccountType ? ga4Formatter : uaFormatter;
+
+            return formatter[method].apply(formatter, arguments);
+        };
+    });
+
+    return proxy;
+});
diff --git a/vendor/magento/module-google-tag-manager/view/frontend/web/js/model/ecommerce/ga4-formatter.js b/vendor/magento/module-google-tag-manager/view/frontend/web/js/model/ecommerce/ga4-formatter.js
