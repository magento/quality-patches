+
+define([
+    'Magento_Checkout/js/model/quote'
+], function (quote) {
+    'use strict';
+
+    var lastTrackedMethod;
+
+    /**
+     * sessionStorage key for the last payment method tracked for the current quote.
+     *
+     * @return {String}
+     */
+    function getStorageKey() {
+        return 'gtm_add_payment_info_' + quote.getQuoteId();
+    }
+
+    lastTrackedMethod = window.sessionStorage.getItem(getStorageKey());
+
+    function normalizeItems() {
+        return quote.getItems().map(function (item) {
+            return {
+                id: item.sku || item.product_id || item.item_id,
+                name: item.name,
+                price: Number(item.price),
+                quantity: Number(item.qty)
+            };
+        });
+    }
+
+    function getPaymentType(paymentMethod) {
+        return paymentMethod.title || paymentMethod.method;
+    }
+
+    return function (selectPaymentMethod) {
+        return function (paymentMethod) {
+            var result = selectPaymentMethod(paymentMethod);
+
+            if (window.dataLayer && paymentMethod && paymentMethod.method !== lastTrackedMethod) {
+                lastTrackedMethod = paymentMethod.method;
+                window.sessionStorage.setItem(getStorageKey(), lastTrackedMethod);
+
+                require(['Magento_GoogleTagManager/js/model/ecommerce/formatter'], function (formatter) {
+                    formatter.addPaymentInfo(
+                        window.dataLayer,
+                        window.dlCurrencyCode,
+                        getPaymentType(paymentMethod),
+                        normalizeItems()
+                    );
+                });
+            }
+
+            return result;
+        };
+    };
+});
