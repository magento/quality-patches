+define([
+    'jquery',
+    'Magento_GoogleTagManager/js/model/ecommerce/formatter'
+], function ($, formatter) {
+    'use strict';
+
+    function normalizeItems(cart) {
+        var i = 0,
+            product,
+            products = [];
+
+        for (i; i < cart.length; i++) {
+            product = cart[i];
+            products.push({
+                id: product.id,
+                name: product.name,
+                price: Number(product.price).toPrecision(4) * 1,
+                quantity: Number(product.qty).toPrecision(4) * 1
+            });
+        }
+
+        return products;
+    }
+
+    function notify(cart) {
+        formatter.viewCart(window.dataLayer, window.dlCurrencyCode, normalizeItems(cart));
+    }
+
+    return function (data) {
+        window.dataLayer ?
+            notify(data.cart) :
+            $(document).on('ga:inited', notify.bind(this, data.cart));
+    };
+});
