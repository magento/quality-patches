+use Magento\Store\Api\Data\StoreInterface;
+use Zend_Db_Select_Exception;
+
+/**
+ * Adds permission rows for products not visible individually, after the normal population pass.
+ *
+ * Reuses the base select's grant computation unmodified and repoints its category/product index
+ * source at a private not-visible-only table. Fails loudly if the source is absent. Then inserts it in product-id
+ * batches (via the same batching the core IndexFiller uses), each guarded by deadlock/lock-wait
+ * retry. This runs independently of (and after) the normal visible-product population, which is
+ * left completely untouched.
+ *
+ * @SuppressWarnings(PHPMD.CouplingBetweenObjects)
+ */
+class IndexFillerPlugin
+{
+    /**
+     * Deployment config path prefix for per-indexer batch sizes.
+     */
+    private const DEPLOYMENT_CONFIG_INDEXER_BATCHES = 'indexer/batch_size/';
+
+    /**
+     * @param Config $config
+     * @param ProductSelectDataProvider $selectDataProvider
+     * @param NotVisibleCategoryProductIndexTable $notVisibleCategoryProductIndexTable
+     * @param DeadlockRecoveryExecutorInterface $deadlockRecoveryExecutor
+     * @param CategoryProductTableMaintainer $categoryProductTableMaintainer
+     * @param QueryGenerator $queryGenerator
+     * @param DeploymentConfig $deploymentConfig
+     * @param int $batchSize
+     */
+    public function __construct(
+        private readonly Config $config,
+        private readonly ProductSelectDataProvider $selectDataProvider,
+        private readonly NotVisibleCategoryProductIndexTable $notVisibleCategoryProductIndexTable,
+        private readonly DeadlockRecoveryExecutorInterface $deadlockRecoveryExecutor,
+        private readonly CategoryProductTableMaintainer $categoryProductTableMaintainer,
+        private readonly QueryGenerator $queryGenerator,
+        private readonly DeploymentConfig $deploymentConfig,
+        private readonly int $batchSize = 10000
+    ) {
+    }
+
+    /**
+     * Add not-visible-individually products to the permissions index after the normal pass.
+     *
+     * @param IndexFiller $subject
+     * @param mixed $result
+     * @param StoreInterface $store
+     * @param int $customerGroupId
+     * @param string $categoryPermissionsTable
+     * @param string $productPermissionsTable
+     * @param array $productIds
+     * @return void
+     * @throws Zend_Db_Select_Exception
+     * @throws \LogicException
+     * @SuppressWarnings(PHPMD.UnusedFormalParameter)
+     */
+    public function afterPopulate(
+        IndexFiller $subject,
+        $result,
+        StoreInterface $store,
+        int $customerGroupId,
+        string $categoryPermissionsTable,
+        string $productPermissionsTable,
+        array $productIds = []
+    ): void {
+        if (false === $this->config->isActive()) {
+            return;
+        }
+
+        $select = $this->getSelect(
+            $store,
+            $customerGroupId,
+            $categoryPermissionsTable,
+            $productIds
+        );
+
+        // Reuse the select's own connection for every subsequent query in this method: it is the
+        // same connection the not-visible temp table was created on (see getSelect()), which
+        // matters because MySQL temporary tables are session-scoped.
+        $connection = $select->getConnection();
+        $batchSize = (int) ($this->deploymentConfig->get(
+            self::DEPLOYMENT_CONFIG_INDEXER_BATCHES . Category::INDEXER_ID
+        ) ?? $this->batchSize);
+
+        // The select is grouped by product_id, so each batch caps the number of distinct products
+        // (a product's category rows are never split across batches). The generator's boundary probe
+        // is retried inside the deadlock-aware iterator; each insert is retried here.
+        foreach ($this->queryGenerator->generate('product_id', $select, $batchSize) as $batchSelect) {
+            $this->deadlockRecoveryExecutor->execute(
+                fn () => $connection->query(
+                    $connection->insertFromSelect(
+                        $batchSelect,
+                        $productPermissionsTable,
+                        [],
+                        AdapterInterface::INSERT_ON_DUPLICATE
+                    )
+                )
+            );
+        }
+    }
+
+    /**
+     * Builds a select for the not-visible-only products.
+     *
+     * Repoints the base select's category/product index source at the store's not-visible-only table.
+     *
+     * @param StoreInterface $store
+     * @param int $customerGroupId
+     * @param string $categoryPermissionsTable
+     * @param int[] $productIds
+     * @return Select
+     * @throws Zend_Db_Select_Exception
+     */
+    private function getSelect(
+        StoreInterface $store,
+        int $customerGroupId,
+        string $categoryPermissionsTable,
+        array $productIds = []
+    ): Select {
+        $select = $this->selectDataProvider->getSelect(
+            $customerGroupId,
+            $store,
+            $categoryPermissionsTable,
+            $productIds
+        );
+
+        $sourceTable = $this->categoryProductTableMaintainer->getMainTable((int) $store->getId());
+
+        $fromPart = $select->getPart(Select::FROM);
+        $matchingAliases = [];
+        foreach ($fromPart as $alias => $part) {
+            if (($part['tableName'] ?? null) === $sourceTable) {
+                $matchingAliases[] = $alias;
+            }
+        }
+
+        // Fails loudly if the source table is not present in the select,
+        // which would indicate a change in the base select's structure.
+        if (empty($matchingAliases)) {
+            throw new \LogicException(
+                sprintf(
+                    '%s::getSelect no longer includes table "%s"; contract appears to have changed.',
+                    ProductSelectDataProvider::class,
+                    $sourceTable
+                )
+            );
+        }
+
+        $notVisibleTable = $this->notVisibleCategoryProductIndexTable->getTableForStore(
+            $select->getConnection(),
+            $store,
+            $productIds
+        );
+        foreach ($matchingAliases as $alias) {
+            $fromPart[$alias]['tableName'] = $notVisibleTable;
+        }
+        $select->setPart(Select::FROM, $fromPart);
+
+        return $select;
+    }
+}
