+namespace Magento\QuickOrder\Plugin\CatalogPermissions\Model\Indexer\Product;
+
+use Magento\B2b\Model\DeadlockRecoveryExecutorInterface;
+use Magento\Catalog\Model\Indexer\Category\Product\TableMaintainer as CategoryProductTableMaintainer;
+use Magento\CatalogPermissions\Model\Indexer\Category;
+use Magento\CatalogPermissions\Model\Indexer\Product\Action\ProductSelectDataProvider;
