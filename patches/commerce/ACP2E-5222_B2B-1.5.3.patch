+declare(strict_types=1);
+
+namespace Magento\QuickOrder\Model\CatalogPermissions\Indexer;
+
+use Magento\Catalog\Model\Indexer\Category\Product\AbstractAction;
+use Magento\Framework\DB\Adapter\AdapterInterface;
+use Magento\Framework\DB\Select;
+use Magento\Store\Model\Store;
+
+/**
+ * Reuses the core category/product indexer join logic to build category-membership
+ * selects for products, scoped by store, without mutating the production category index.
+ */
+class NotVisibleCategoryProductSelectBuilder extends AbstractAction
+{
+    /**
+     * Not supported; this class only exposes select builders for reuse and must never run as a real indexer action
+     *
+     * @return void
+     */
+    public function execute()
+    {
+        throw new \LogicException(
+            self::class . ' only exposes select builders for reuse and must not be executed.'
+        );
+    }
+
+    /**
+     * Get select for products directly assigned to non-anchor categories.
+     *
+     * The inherited select is memoized per store by the parent class, so it must be cloned
+     * before adding a product filter — mutating it directly would leak the filter into every
+     * later call for the same store, including unfiltered (full-reindex) ones.
+     *
+     * @param AdapterInterface $connection
+     * @param Store $store
+     * @param int[] $productIds
+     * @return Select
+     */
+    public function getNonAnchorSelect(AdapterInterface $connection, Store $store, array $productIds = []): Select
+    {
+        $this->useConnection($connection);
+
+        return $this->filterByProductIds(clone $this->getNonAnchorCategoriesSelect($store), $productIds);
+    }
+
+    /**
+     * Get select for products propagated to anchor categories.
+     *
+     * The inherited select is memoized per store by the parent class, so it must be cloned
+     * before adding a product filter — mutating it directly would leak the filter into every
+     * later call for the same store, including unfiltered (full-reindex) ones.
+     *
+     * @param AdapterInterface $connection
+     * @param Store $store
+     * @param int[] $productIds
+     * @return Select
+     */
+    public function getAnchorSelect(AdapterInterface $connection, Store $store, array $productIds = []): Select
+    {
+        $this->useConnection($connection);
+
+        return $this->filterByProductIds(clone $this->getAnchorCategoriesSelect($store), $productIds);
+    }
+
+    /**
+     * Rebind the inherited connection to the caller's, clearing all connection-bound state.
+     *
+     * The parent class caches its own connection at construction and builds its temporary
+     * category-tree index table on it. When the caller's connection differs (e.g. under
+     * multi-threaded indexing, where this object and the caller's connection may have been
+     * resolved at different times relative to a connection-registry reset), that cached
+     * connection is swapped and all connection-bound memoized state is cleared via
+     * {@see AbstractAction::_resetState()}, so every select this class returns — and every
+     * temporary table it creates — is guaranteed to live on the caller's connection.
+     *
+     * @param AdapterInterface $connection
+     * @return void
+     */
+    private function useConnection(AdapterInterface $connection): void
+    {
+        if ($connection !== $this->connection) {
+            $this->_resetState();
+            $this->connection = $connection;
+        }
+    }
+
+    /**
+     * Restrict a select to the given product IDs, when a specific list is provided.
+     *
+     * @param Select $select
+     * @param int[] $productIds
+     * @return Select
+     */
+    private function filterByProductIds(Select $select, array $productIds): Select
+    {
+        if (!empty($productIds)) {
+            $select->where('ccp.product_id IN (?)', $productIds, 'INT');
+        }
+
+        return $select;
+    }
+}
