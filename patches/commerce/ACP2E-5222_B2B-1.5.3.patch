+ */
+declare(strict_types=1);
+
+namespace Magento\B2b\Model;
+
+/**
+ * Retries a DB operation on transient lock conflicts (deadlock / lock-wait).
+ *
+ * Lives in the base B2B module so any B2B module can reuse the same backoff tuning without
+ * depending on another feature module or on core classes that a separately released B2B build
+ * may run against an older baseline of.
+ */
+interface DeadlockRecoveryExecutorInterface
+{
+    /**
+     * Execute the callable, retrying on DeadlockException/LockWaitException with backoff.
+     *
+     * Any other Throwable propagates immediately, without a retry.
+     *
+     * @param callable $callable
+     * @param array $args Arguments forwarded to the callable.
+     * @return mixed The callable's return value.
+     */
+    public function execute(callable $callable, array $args = []): mixed;
+}
