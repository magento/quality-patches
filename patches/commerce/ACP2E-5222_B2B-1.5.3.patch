+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\B2b\Model;
+
+/**
+ * Tuning for deadlock/lock-wait recovery: attempt count and backoff delays.
+ *
+ * Lives in the base B2B module so any B2B module can reuse the same backoff tuning without
+ * depending on another feature module or on core classes that a separately released B2B build
+ * may run against an older baseline of.
+ */
+interface DeadlockRecoveryConfigInterface
+{
+    /**
+     * Maximum number of attempts before propagating the exception.
+     *
+     * @return int
+     */
+    public function getMaxAttempts(): int;
+
+    /**
+     * Base delay in microseconds for the exponential backoff (used for the first retry).
+     *
+     * @return int
+     */
+    public function getBaseDelay(): int;
+
+    /**
+     * Maximum delay cap in microseconds for any single retry attempt.
+     *
+     * @return int
+     */
+    public function getMaxDelay(): int;
+
+    /**
+     * Upper bound for random jitter added to each retry delay, in microseconds.
+     *
+     * @return int
+     */
+    public function getJitter(): int;
+}
