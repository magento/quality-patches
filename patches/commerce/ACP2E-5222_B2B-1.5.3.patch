+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\B2b\Model\ResourceModel\DeadlockRecovery;
+
+use Magento\B2b\Model\DeadlockRecoveryExecutorInterface;
+use Magento\Framework\DB\Query\BatchIteratorInterface;
+use Magento\Framework\DB\Select;
+
+/**
+ * Batch iterator whose per-batch boundary probe is retried on transient DB lock conflicts.
+ *
+ * Duplicates the framework BatchIterator's keyset logic (rather than subclassing it) so the retry can
+ * be integrated cleanly: the MAX/COUNT boundary probe runs inside the deadlock-recovery executor, and
+ * the cursor ($minValue) and current select are advanced only after a probe succeeds. A deadlocked
+ * probe is therefore truly re-run against the same select — no batch is skipped or served without a
+ * completed probe. Callers should still wrap the per-batch work (e.g. the insert) in the same executor.
+ */
+class BatchIterator implements BatchIteratorInterface
+{
+    /**
+     * @var int
+     */
+    private $minValue = 0;
+
+    /**
+     * @var int
+     */
+    private int $iteration = 0;
+
+    /**
+     * @var bool
+     */
+    private bool $isValid = true;
+
+    /**
+     * @var Select|null
+     */
+    private ?Select $currentSelect = null;
+
+    /**
+     * @param DeadlockRecoveryExecutorInterface $deadlockRecoveryExecutor
+     * @param Select $select
+     * @param int $batchSize
+     * @param string $correlationName
+     * @param string $rangeField
+     * @param string $rangeFieldAlias
+     */
+    public function __construct(
+        private readonly DeadlockRecoveryExecutorInterface $deadlockRecoveryExecutor,
+        private readonly Select $select,
+        private readonly int $batchSize,
+        private readonly string $correlationName,
+        private readonly string $rangeField,
+        private readonly string $rangeFieldAlias
+    ) {
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function current()
+    {
+        if (null === $this->currentSelect) {
+            $select = $this->initSelectObject();
+            $this->isValid = $this->calculateBatchSize($select) > 0;
+            $this->currentSelect = $select;
+        }
+        return $this->currentSelect;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function next()
+    {
+        if (null === $this->currentSelect) {
+            $this->current();
+        }
+        $select = $this->initSelectObject();
+        $this->isValid = $this->calculateBatchSize($select) > 0;
+        if ($this->isValid) {
+            $this->iteration++;
+            $this->currentSelect = $select;
+        } else {
+            $this->currentSelect = null;
+        }
+        return $this->currentSelect;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function key()
+    {
+        return $this->iteration;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function valid()
+    {
+        return $this->isValid;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function rewind()
+    {
+        $this->minValue = 0;
+        $this->currentSelect = null;
+        $this->iteration = 0;
+        $this->isValid = true;
+    }
+
+    /**
+     * Run the boundary probe and advance the cursor, retrying on transient lock conflicts.
+     *
+     * The whole probe — including advancing $minValue — runs inside the executor, so a transient
+     * deadlock/lock-wait re-runs it against the same select and leaves the cursor untouched until it
+     * succeeds. The caller only mutates iterator state after this returns.
+     *
+     * @param Select $select
+     * @return int
+     */
+    private function calculateBatchSize(Select $select): int
+    {
+        return (int) $this->deadlockRecoveryExecutor->execute(
+            function () use ($select): int {
+                $connection = $this->select->getConnection();
+                $wrapperSelect = $connection->select();
+                $wrapperSelect->from(
+                    $select,
+                    [
+                        new \Zend_Db_Expr('MAX(' . $this->rangeFieldAlias . ') as max'),
+                        new \Zend_Db_Expr('COUNT(*) as cnt'),
+                    ]
+                );
+                $row = $connection->fetchRow($wrapperSelect);
+                $this->minValue = $row['max'];
+                return (int) $row['cnt'];
+            }
+        );
+    }
+
+    /**
+     * Build the select for the next batch, bounded by the current cursor value.
+     *
+     * @return Select
+     */
+    private function initSelectObject(): Select
+    {
+        $connection = $this->select->getConnection();
+        $object = clone $this->select;
+        $object->where(
+            $connection->quoteIdentifier($this->correlationName)
+            . '.' . $connection->quoteIdentifier($this->rangeField)
+            . ' > ?',
+            $this->minValue
+        );
+        $object->limit($this->batchSize);
+        $object->order($this->correlationName . '.' . $this->rangeField . ' ' . Select::SQL_ASC);
+
+        return $object;
+    }
+}
