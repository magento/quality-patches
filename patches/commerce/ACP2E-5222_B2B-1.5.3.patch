+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\QuickOrder\Model\CatalogPermissions\Indexer;
+
+use Magento\B2b\ObjectManager\ResetAfterRequestInterface;
+use Magento\Catalog\Model\Indexer\Category\Product\TableMaintainer as CategoryProductTableMaintainer;
+use Magento\Framework\DB\Adapter\AdapterInterface;
+use Magento\Store\Api\Data\StoreInterface;
+
+/**
+ * Builds and caches a temporary category/product index for products that are not visible
+ * individually.
+ *
+ * The table is reused per store when the requested product IDs are unchanged. Because MySQL
+ * temporary tables are scoped to a single connection, the cache also stores the DB connection
+ * used to build each table.
+ */
+class NotVisibleCategoryProductIndexTable implements ResetAfterRequestInterface
+{
+    /**
+     * Table name suffix identifying the private not-visible-products index for a store.
+     */
+    private const TABLE_SUFFIX = '_not_visible_tmp';
+
+    /**
+     * @var array<int, array{table: string, key: string, connection: AdapterInterface}> Cache of the table
+     *      name, product ID list hash, and connection per store.
+     */
+    private array $cache = [];
+
+    /**
+     * @param NotVisibleCategoryProductSelectBuilder $selectBuilder
+     * @param CategoryProductTableMaintainer $categoryProductTableMaintainer
+     */
+    public function __construct(
+        private readonly NotVisibleCategoryProductSelectBuilder $selectBuilder,
+        private readonly CategoryProductTableMaintainer $categoryProductTableMaintainer
+    ) {
+    }
+
+    /**
+     * Get the name of the not-visible-products category index table for the given store.
+     *
+     * The table is created on the given connection, and only that connection can see it.
+     * Callers must reuse this same connection for every subsequent query that needs to reference the table.
+     *
+     * @param AdapterInterface $connection
+     * @param StoreInterface $store
+     * @param int[] $productIds
+     * @return string
+     */
+    public function getTableForStore(
+        AdapterInterface $connection,
+        StoreInterface $store,
+        array $productIds = []
+    ): string {
+        $storeId = (int) $store->getId();
+        $key = $this->productIdsKey($productIds);
+
+        if (!isset($this->cache[$storeId])
+            || $this->cache[$storeId]['key'] !== $key
+            || $this->cache[$storeId]['connection'] !== $connection
+        ) {
+            $this->cache[$storeId]['table'] = $this->buildTable($connection, $store, $storeId, $productIds);
+            $this->cache[$storeId]['key'] = $key;
+            $this->cache[$storeId]['connection'] = $connection;
+        }
+
+        return $this->cache[$storeId]['table'];
+    }
+
+    /**
+     * Build a stable, order-independent comparison key for a product ID list.
+     *
+     * @param int[] $productIds
+     * @return string
+     */
+    private function productIdsKey(array $productIds): string
+    {
+        sort($productIds);
+
+        return implode(',', $productIds);
+    }
+
+    /**
+     * Build the private temporary table for the given store.
+     *
+     * @param AdapterInterface $connection
+     * @param StoreInterface $store
+     * @param int $storeId
+     * @param int[] $productIds
+     * @return string
+     */
+    private function buildTable(
+        AdapterInterface $connection,
+        StoreInterface $store,
+        int $storeId,
+        array $productIds
+    ): string {
+        $sourceTable = $this->categoryProductTableMaintainer->getMainTable($storeId);
+        $tempTable = $sourceTable . self::TABLE_SUFFIX;
+
+        // The table may already exist (and hold rows) from an earlier build against the same
+        // connection with a different product ID list; always start from an empty table.
+        $connection->dropTemporaryTable($tempTable);
+        $connection->createTemporaryTableLike($tempTable, $sourceTable);
+        $columns = array_keys($connection->describeTable($tempTable));
+
+        $selects = [
+            $this->selectBuilder->getNonAnchorSelect($connection, $store, $productIds),
+            $this->selectBuilder->getAnchorSelect($connection, $store, $productIds),
+        ];
+        foreach ($selects as $select) {
+            $connection->query(
+                $connection->insertFromSelect($select, $tempTable, $columns, AdapterInterface::INSERT_ON_DUPLICATE)
+            );
+        }
+
+        return $tempTable;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function _resetState(): void
+    {
+        $this->cache = [];
+    }
+}
