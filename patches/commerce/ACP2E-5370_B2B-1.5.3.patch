@@ -0,0 +1,99 @@
+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\RequisitionList\Observer;
+
+use Magento\Authorization\Model\UserContextInterface;
+use Magento\Framework\App\CacheInterface;
+use Magento\Framework\Event\Observer;
+use Magento\Framework\Event\ObserverInterface;
+use Magento\Framework\Exception\InputException;
+use Magento\Framework\Stdlib\Cookie\CookieMetadataFactory;
+use Magento\Framework\Stdlib\Cookie\CookieReaderInterface;
+use Magento\Framework\Stdlib\Cookie\CookieSizeLimitReachedException;
+use Magento\Framework\Stdlib\Cookie\FailureToSendException;
+use Magento\Framework\Stdlib\CookieManagerInterface;
+use Magento\RequisitionList\Model\Config;
+use Magento\RequisitionList\Model\RequisitionVersionCache;
+
+/**
+ * Sets a public version cookie on authenticated frontend responses so that
+ * any browser can detect stale requisition section data and trigger a reload.
+ *
+ * Checked on every authenticated request so cross-browser sync is never delayed; the read
+ * load this implies is bounded via the isActive() gate and a dedup check against the cookie
+ * already present on the request, rather than a time-based throttle (which was tried and
+ * reverted - it introduced a several-second cross-browser sync delay on create/delete).
+ *
+ * @SuppressWarnings(PHPMD.CookieAndSessionMisuse)
+ */
+class SetRequisitionVersionCookieObserver implements ObserverInterface
+{
+    private const COOKIE_NAME = 'requisition_list_version';
+    private const COOKIE_DURATION = 86400;
+
+    /**
+     * @param CacheInterface $cache
+     * @param UserContextInterface $userContext
+     * @param CookieManagerInterface $cookieManager
+     * @param CookieMetadataFactory $cookieMetadataFactory
+     * @param CookieReaderInterface $cookieReader
+     * @param Config $requisitionListConfig
+     */
+    public function __construct(
+        private readonly CacheInterface $cache,
+        private readonly UserContextInterface $userContext,
+        private readonly CookieManagerInterface $cookieManager,
+        private readonly CookieMetadataFactory $cookieMetadataFactory,
+        private readonly CookieReaderInterface $cookieReader,
+        private readonly Config $requisitionListConfig
+    ) {
+    }
+
+    /**
+     * Set the requisition version cookie on authenticated frontend responses.
+     *
+     * @param Observer $observer
+     * @return void
+     * @throws InputException
+     * @throws CookieSizeLimitReachedException
+     * @throws FailureToSendException
+     * @SuppressWarnings(PHPMD.UnusedFormalParameter)
+     */
+    public function execute(Observer $observer): void
+    {
+        $customerId = (int) $this->userContext->getUserId();
+        if (!$customerId || !$this->requisitionListConfig->isActive()) {
+            return;
+        }
+
+        $version = $this->cache->load(RequisitionVersionCache::CACHE_PREFIX . $customerId);
+        if ($version === false || $this->cookieReader->getCookie(self::COOKIE_NAME) === $version) {
+            return;
+        }
+
+        $metadata = $this->cookieMetadataFactory
+            ->createPublicCookieMetadata()
+            ->setPath('/')
+            ->setDuration(self::COOKIE_DURATION)
+            ->setHttpOnly(false)
+            ->setSameSite('Lax');
+
+        $this->cookieManager->setPublicCookie(self::COOKIE_NAME, $version, $metadata);
+    }
+}
