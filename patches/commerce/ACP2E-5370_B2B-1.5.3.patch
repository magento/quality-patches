+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\RequisitionListGraphQl\Model\RequisitionList;
+
+use Magento\RequisitionList\Api\RequisitionListRepositoryInterface;
+use Magento\RequisitionList\Model\RequisitionVersionCache;
+
+/**
+ * Stamps a new requisition list version for the list owner.
+ *
+ * Used by GraphQL mutations that modify requisition list items directly via
+ * Magento\RequisitionList\Model\RequisitionList\Items, bypassing
+ * RequisitionListRepository::save()/delete() (the only place that otherwise
+ * calls RequisitionVersionCache::updateVersion()), so cross-browser sync for
+ * those operations does not silently break.
+ */
+class VersionUpdater
+{
+    /**
+     * @var RequisitionListRepositoryInterface
+     */
+    private $requisitionListRepository;
+
+    /**
+     * @var RequisitionVersionCache
+     */
+    private $requisitionVersionCache;
+
+    /**
+     * @param RequisitionListRepositoryInterface $requisitionListRepository
+     * @param RequisitionVersionCache $requisitionVersionCache
+     */
+    public function __construct(
+        RequisitionListRepositoryInterface $requisitionListRepository,
+        RequisitionVersionCache $requisitionVersionCache
+    ) {
+        $this->requisitionListRepository = $requisitionListRepository;
+        $this->requisitionVersionCache = $requisitionVersionCache;
+    }
+
+    /**
+     * Stamp a new version for the given list's owner.
+     *
+     * @param int $requisitionListId
+     * @return void
+     */
+    public function execute(int $requisitionListId): void
+    {
+        $customerId = (int) $this->requisitionListRepository->get($requisitionListId)->getCustomerId();
+        $this->requisitionVersionCache->updateVersion($customerId);
+    }
+}
