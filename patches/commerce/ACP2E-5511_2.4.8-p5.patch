+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\ResourceConnections\Plugin;
+
+use Magento\Framework\DB\Adapter\AdapterInterface;
+use Magento\ResourceConnections\DB\Adapter\DdlCacheResetNotifier;
+
+class DdlCacheResetObserver
+{
+    /**
+     * @param DdlCacheResetNotifier $ddlCacheResetNotifier
+     */
+    public function __construct(
+        private readonly DdlCacheResetNotifier $ddlCacheResetNotifier
+    ) {
+    }
+
+    /**
+     * Notify the registry after a connection resets its DDL cache.
+     *
+     * @param AdapterInterface $subject
+     * @param AdapterInterface $result
+     * @param string|null $tableName
+     * @param string|null $schemaName
+     * @return AdapterInterface
+     */
+    public function afterResetDdlCache(
+        AdapterInterface $subject,
+        $result,
+        $tableName = null,
+        $schemaName = null
+    ) {
+        $this->ddlCacheResetNotifier->notify($subject, $tableName, $schemaName);
+        return $result;
+    }
+}
