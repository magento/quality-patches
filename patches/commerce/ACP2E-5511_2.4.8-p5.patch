+declare(strict_types=1);
+
+namespace Magento\ResourceConnections\DB\Adapter;
+
+use Magento\Framework\DB\Adapter\AdapterInterface;
+use Magento\Framework\ObjectManager\ResetAfterRequestInterface;
+use Magento\ResourceConnections\DB\Adapter\Pdo\MysqlProxy;
+use WeakMap;
+
+/**
+ * Notifies related connections when a connection resets its DDL cache.
+ */
+class DdlCacheResetNotifier implements ResetAfterRequestInterface
+{
+    /**
+     * @var WeakMap<AdapterInterface, WeakMap<MysqlProxy, bool>>
+     */
+    private WeakMap $subscribers;
+
+    /**
+     * @var bool
+     */
+    private bool $inProgress = false;
+
+    /**
+     * Initialize dependencies.
+     */
+    public function __construct()
+    {
+        $this->subscribers = new WeakMap();
+    }
+
+    /**
+     * Subscribe a connection to DDL cache reset notifications.
+     *
+     * @param AdapterInterface $connection
+     * @param MysqlProxy $proxy
+     * @return void
+     */
+    public function subscribe(AdapterInterface $connection, MysqlProxy $proxy): void
+    {
+        if (!isset($this->subscribers[$connection])) {
+            $this->subscribers[$connection] = new WeakMap();
+        }
+        $proxies = $this->subscribers[$connection];
+        $proxies[$proxy] = true;
+    }
+
+    /**
+     * Unsubscribe a connection from DDL cache reset notifications.
+     *
+     * @param AdapterInterface $connection
+     * @param MysqlProxy $proxy
+     * @return void
+     */
+    public function unsubscribe(AdapterInterface $connection, MysqlProxy $proxy): void
+    {
+        if (isset($this->subscribers[$connection])) {
+            $proxies = $this->subscribers[$connection];
+            unset($proxies[$proxy]);
+            if (count($proxies) === 0) {
+                unset($this->subscribers[$connection]);
+            }
+        }
+    }
+
+    /**
+     * Propagate a DDL cache reset to related connections.
+     *
+     * @param AdapterInterface $origin
+     * @param string|null $tableName
+     * @param string|null $schemaName
+     * @return void
+     */
+    public function notify(AdapterInterface $origin, $tableName = null, $schemaName = null): void
+    {
+        if ($this->inProgress || !isset($this->subscribers[$origin])) {
+            return;
+        }
+
+        $this->inProgress = true;
+        try {
+            foreach ($this->getPeerConnections($origin) as $connection) {
+                if ($connection !== $origin) {
+                    $connection->resetDdlCache($tableName, $schemaName);
+                }
+            }
+        } finally {
+            $this->inProgress = false;
+        }
+    }
+
+    /**
+     * Get connections that share a proxy with the origin connection.
+     *
+     * @param AdapterInterface $origin
+     * @return AdapterInterface[]
+     */
+    private function getPeerConnections(AdapterInterface $origin): array
+    {
+        $connections = [];
+        $originProxies = $this->subscribers[$origin];
+        foreach ($this->subscribers as $connection => $proxies) {
+            if ($connection !== $origin) {
+                foreach ($originProxies as $proxy => $isRegistered) {
+                    if ($isRegistered && isset($proxies[$proxy])) {
+                        $connections[] = $connection;
+                        break;
+                    }
+                }
+            }
+        }
+
+        return $connections;
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function _resetState(): void
+    {
+        $this->subscribers = new WeakMap();
+    }
+}
