+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\CustomerSegment\Model\ResourceModel;
+
+use Magento\Framework\App\ResourceConnection;
+use Magento\Framework\Serialize\SerializerInterface;
+
+/**
+ * Identify changes to the persisted cart data used by segment conditions.
+ */
+class QuoteState
+{
+    /**
+     * @param ResourceConnection $resource
+     * @param SerializerInterface $serializer
+     */
+    public function __construct(
+        private readonly ResourceConnection $resource,
+        private readonly SerializerInterface $serializer
+    ) {
+    }
+
+    /**
+     * Get the state of all active carts considered by customer segment conditions.
+     *
+     * @param int $customerId
+     * @param int $websiteId
+     * @return string
+     */
+    public function get(int $customerId, int $websiteId): string
+    {
+        $connection = $this->resource->getConnection();
+        $select = $connection->select()
+            ->from(['quote' => $this->resource->getTableName('quote')])
+            ->join(
+                ['store' => $this->resource->getTableName('store')],
+                'quote.store_id = store.store_id',
+                []
+            )
+            ->where('quote.customer_id = ?', $customerId)
+            ->where('quote.is_active = ?', 1)
+            ->where('store.website_id = ?', $websiteId)
+            ->order('quote.entity_id');
+        $quotes = $connection->fetchAll($select);
+        $quoteIds = array_column($quotes, 'entity_id');
+        $state = ['quote' => $quotes];
+        foreach (['quote_item' => 'item_id', 'quote_address' => 'address_id'] as $table => $idField) {
+            $state[$table] = $quoteIds ? $connection->fetchAll(
+                $connection->select()
+                    ->from($this->resource->getTableName($table))
+                    ->where('quote_id IN (?)', $quoteIds)
+                    ->order($idField)
+            ) : [];
+        }
+        foreach ($state as &$rows) {
+            foreach ($rows as &$row) {
+                unset($row['updated_at']);
+            }
+            unset($row);
+        }
+        unset($rows);
+
+        return hash('sha256', $this->serializer->serialize($state));
+    }
+}
