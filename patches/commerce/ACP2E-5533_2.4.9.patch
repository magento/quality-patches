+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\CustomerSegment\Observer;
+
+use Magento\CustomerSegment\Helper\Data;
+use Magento\CustomerSegment\Model\Customer;
+use Magento\CustomerSegment\Model\QuoteMatcher;
+use Magento\Framework\App\Config\ScopeConfigInterface;
+use Magento\Framework\Event\Observer;
+use Magento\Framework\Event\ObserverInterface;
+use Magento\Quote\Model\Quote;
+
+/**
+ * Refresh registered customer segments affected by GraphQL cart operations.
+ */
+class ProcessQuoteGraphQlObserver implements ObserverInterface
+{
+    /**
+     * @param QuoteMatcher $quoteMatcher
+     * @param ProcessEventGenericObserver $processEventObserver
+     * @param Data $segmentHelper
+     * @param ScopeConfigInterface $scopeConfig
+     */
+    public function __construct(
+        private readonly QuoteMatcher $quoteMatcher,
+        private readonly ProcessEventGenericObserver $processEventObserver,
+        private readonly Data $segmentHelper,
+        private readonly ScopeConfigInterface $scopeConfig
+    ) {
+    }
+
+    /**
+     * @inheritdoc
+     */
+    public function execute(Observer $observer): void
+    {
+        if (!$this->segmentHelper->isEnabled()) {
+            return;
+        }
+        /** @var Quote $quote */
+        $quote = $observer->getEvent()->getQuote();
+        $customerId = (int) $quote->getCustomerId();
+        $beforeTotals = $observer->getEvent()->getName() === 'sales_quote_address_collect_totals_before';
+        if (!$customerId) {
+            if (!$beforeTotals) {
+                $this->processEventObserver->execute($observer);
+            }
+            return;
+        }
+
+        $websiteId = (int) $quote->getStore()->getWebsiteId();
+        if (!$beforeTotals
+            && !$this->scopeConfig->getValue(Customer::XML_PATH_REAL_TIME_CHECK_IF_CUSTOMER_IS_MATCHED_BY_SEGMENT)
+        ) {
+            $this->quoteMatcher->invalidate($customerId, $websiteId);
+            $this->processEventObserver->execute($observer);
+            return;
+        }
+        $this->quoteMatcher->execute($customerId, $websiteId);
+    }
+}
