+++ b/vendor/magento/module-customer-segment/Model/QuoteMatcher.php
@@ -0,0 +1,180 @@
+<?php
+/**
+ * ADOBE CONFIDENTIAL
+ *
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ *
+ * NOTICE: All information contained herein is, and remains
+ * the property of Adobe and its suppliers, if any. The intellectual
+ * and technical concepts contained herein are proprietary to Adobe
+ * and its suppliers and are protected by all applicable intellectual
+ * property laws, including trade secret and copyright laws.
+ * Dissemination of this information or reproduction of this material
+ * is strictly forbidden unless prior written permission is obtained
+ * from Adobe.
+ */
+declare(strict_types=1);
+
+namespace Magento\CustomerSegment\Model;
+
+use Magento\CustomerSegment\Model\ResourceModel\QuoteState;
+use Magento\CustomerSegment\Model\ResourceModel\Segment\CollectionFactory;
+use Magento\Framework\Exception\LocalizedException;
+use Magento\Framework\ObjectManager\ResetAfterRequestInterface;
+
+/**
+ * Refresh cart-dependent customer memberships once per persisted cart state.
+ */
+class QuoteMatcher implements ResetAfterRequestInterface
+{
+    private const DEFAULT_EVENTS = [
+        'sales_quote_address_collect_totals_before',
+        'sales_quote_save_commit_after',
+        'sales_quote_collect_totals_after',
+        'checkout_cart_save_after',
+    ];
+
+    /**
+     * @var array<string, array{state: string, memberships: array, results: array}>
+     */
+    private array $validated = [];
+
+    /**
+     * @param CollectionFactory $collectionFactory
+     * @param Customer $customer
+     * @param QuoteState $quoteState
+     * @param string[] $events Replacement event list; an empty list disables matching.
+     */
+    public function __construct(
+        private readonly CollectionFactory $collectionFactory,
+        private readonly Customer $customer,
+        private readonly QuoteState $quoteState,
+        private readonly array $events = self::DEFAULT_EVENTS
+    ) {
+    }
+
+    /**
+     * Update only memberships that can be affected by cart changes.
+     *
+     * @param int $customerId
+     * @param int $websiteId
+     * @return void
+     * @throws LocalizedException
+     */
+    public function execute(int $customerId, int $websiteId): void
+    {
+        if (!$this->events) {
+            return;
+        }
+        $key = $customerId . '_' . $websiteId;
+        $state = $this->quoteState->get($customerId, $websiteId);
+        if ($this->isCurrent($key, $state, $customerId, $websiteId)) {
+            return;
+        }
+        $this->invalidate($customerId, $websiteId);
+
+        $segments = $this->collectionFactory->create();
+        $segments->addWebsiteFilter($websiteId);
+        $segments->addIsActiveFilter(1);
+        $segments->addFieldToFilter(
+            'apply_to',
+            [Segment::APPLY_TO_REGISTERED, Segment::APPLY_TO_VISITORS_AND_REGISTERED]
+        );
+        $events = $segments->getConnection()->select()
+            ->from($segments->getTable('magento_customersegment_event'), ['segment_id'])
+            ->where('event IN (?)', $this->events);
+        $segments->getSelect()->where('main_table.segment_id IN (?)', $events);
+
+        $results = [];
+        foreach ($segments as $segment) {
+            $results[(int) $segment->getId()] = (bool) $segment->validateCustomer($customerId, $websiteId);
+        }
+        if ($results) {
+            $this->customer->addCustomerToWebsiteSegments(
+                $customerId,
+                $websiteId,
+                array_keys(array_filter($results))
+            );
+            $this->customer->removeCustomerFromWebsiteSegments(
+                $customerId,
+                $websiteId,
+                array_keys(array_filter($results, static fn (bool $matched): bool => !$matched))
+            );
+        }
+        $this->validated[$key] = [
+            'state' => $state,
+            'memberships' => $this->getMemberships($customerId, $websiteId),
+            'results' => $results,
+        ];
+    }
+
+    /**
+     * Reuse fresh cart-dependent results during advanced sales rule filtering.
+     *
+     * @param int $customerId
+     * @param int $websiteId
+     * @return array<int, bool>
+     */
+    public function getResults(int $customerId, int $websiteId): array
+    {
+        $key = $customerId . '_' . $websiteId;
+        if (!isset($this->validated[$key])) {
+            return [];
+        }
+        $state = $this->quoteState->get($customerId, $websiteId);
+        return $this->isCurrent($key, $state, $customerId, $websiteId)
+            ? $this->validated[$key]['results']
+            : [];
+    }
+
+    /**
+     * Discard results before another processing path or a fresh validation attempt.
+     *
+     * @param int $customerId
+     * @param int $websiteId
+     * @return void
+     */
+    public function invalidate(int $customerId, int $websiteId): void
+    {
+        unset($this->validated[$customerId . '_' . $websiteId]);
+    }
+
+    /**
+     * Check both cart inputs and memberships changed by other customer events.
+     *
+     * @param string $key
+     * @param string $state
+     * @param int $customerId
+     * @param int $websiteId
+     * @return bool
+     */
+    private function isCurrent(string $key, string $state, int $customerId, int $websiteId): bool
+    {
+        return isset($this->validated[$key])
+            && $this->validated[$key]['state'] === $state
+            && $this->validated[$key]['memberships'] === $this->getMemberships($customerId, $websiteId);
+    }
+
+    /**
+     * Get consistently ordered membership IDs.
+     *
+     * @param int $customerId
+     * @param int $websiteId
+     * @return int[]
+     */
+    private function getMemberships(int $customerId, int $websiteId): array
+    {
+        $ids = array_map('intval', $this->customer->getCustomerSegmentIdsForWebsite($customerId, $websiteId));
+        sort($ids);
+        return $ids;
+    }
+
+    /**
+     * @inheritdoc
+     */
+    public function _resetState(): void
+    {
+        $this->validated = [];
+    }
+}
