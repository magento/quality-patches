diff --git a/vendor/magento/module-inventory-in-store-pickup-quote/Plugin/Checkout/ShippingInformationManagementPlugin.php b/vendor/magento/module-inventory-in-store-pickup-quote/Plugin/Checkout/ShippingInformationManagementPlugin.php
