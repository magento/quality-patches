diff --git a/vendor/magento/module-catalog-graph-ql/Plugin/DataProvider/Product/SearchCriteriaBuilderPlugin.php b/vendor/magento/module-catalog-graph-ql/Plugin/DataProvider/Product/SearchCriteriaBuilderPlugin.php
